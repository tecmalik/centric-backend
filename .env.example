PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Prisma (Session Pooler connection string for schema migrations)
# Get this from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> Pooler (session mode)
# The direct host db.<ref>.supabase.co is IPv6-only; use the pooler on IPv4 networks.
# Example: postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=require
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=30d

# Optional: Gemini API Key for smart package classification
# GEMINI_API_KEY=your_gemini_api_key
